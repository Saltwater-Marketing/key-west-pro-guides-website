{% if isHome %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "{{ site.url }}/#business",
  "name": "{{ site.name }}",
  "url": "{{ site.url }}/",
  "telephone": "+1-305-747-4650",
  "email": "{{ site.email }}",
  "image": "{{ site.url }}{% imgurl 'home/banner-desktop.jpg', 1200 %}",
  "description": "{{ description }}",
  "foundingDate": "1998",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.address.street }}",
    "addressLocality": "{{ site.address.city }}",
    "addressRegion": "{{ site.address.region }}",
    "postalCode": "{{ site.address.zip }}",
    "addressCountry": "{{ site.address.country }}"
  },
  "hasMap": "{{ site.mapsUrl }}",
  "areaServed": "Key West, Florida",
  "sameAs": ["{{ site.social.facebook }}", "{{ site.tripadvisor }}"]
}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","name":"{{ site.name }}","url":"{{ site.url }}/"}
</script>
{% endif %}
{% if crumbs %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"}{% for c in crumbs %},
{"@type":"ListItem","position":{{ loop.index + 1 }},"name":{{ c.label | json | safe }}{% if c.url %},"item":"{{ site.url }}{{ c.url }}"{% else %},"item":"{{ page.url | abs(site) }}"{% endif %}}{% endfor %}
]}
</script>
{% endif %}
{% if isPost %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | json | safe }},
  "datePublished": "{{ page.date | isoDate }}",
  "author": {"@type": "Person", "name": "{{ author or 'Capt. Paul Tryon' }}"},
  "publisher": {"@type": "Organization", "name": "{{ site.name }}", "url": "{{ site.url }}/"},
  "mainEntityOfPage": "{{ page.url | abs(site) }}"{% if ogImage %},
  "image": "{{ site.url }}{% imgurl ogImage, 1200 %}"{% endif %}
}
</script>
{% endif %}
{% if faqSchema and faqs %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in faqs %}{% if f.a %}{% if not loop.first %},{% endif %}
{"@type":"Question","name":{{ f.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | striptags | json | safe }}}}{% endif %}{% endfor %}
]}
</script>
{% endif %}
