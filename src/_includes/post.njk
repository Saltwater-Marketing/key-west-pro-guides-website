---
layout: base.njk
isPost: true
ogType: article
navKey: Fishing Reports
---
<article class="sec">
  <div class="prose">
    <p class="crumbs" style="color:var(--ink)"><a href="/">Home</a> / <a href="/fishing-reports">Fishing Reports</a></p>
    <h1>{{ title }}</h1>
    <p class="meta-line">{{ page.date | longDate }} · {{ author }}</p>
    {{ content | safe }}
    <div class="cta" style="text-align:left">
      <a class="btn" href="{{ site.booking.url }}" target="_blank" rel="noopener">{{ site.booking.label }}</a>
      <p class="or">or call <a href="{{ site.phoneHref }}">{{ site.phone }}</a></p>
    </div>
  </div>
</article>
<section class="sec-sm tint">
  <div class="wrap">
    <h2 style="font-size:26px">More from the Key West Pro Guides Fishing Report</h2>
    <div class="g3" style="margin-top:20px">
      {% for p in (collections.posts | notUrl(page.url) | limit(3)) %}
      <a class="pcard" href="{{ p.url | clean }}">{% if p.data.ogImage %}{% img p.data.ogImage, p.data.title, "(max-width: 1023px) 100vw, 400px", "" %}{% endif %}<h3>{{ p.data.title }}</h3><p>{{ p.date | longDate }}</p></a>
      {% endfor %}
    </div>
  </div>
</section>
